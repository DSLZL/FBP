{
  "name": "Factorio_Blueprint_Printer",
  "version": "0.3.4",
  "title": "Factorio Blueprint Printer",
  "author": "DSLZL",
  "factorio_version": "2.0",
  "dependencies": [
    "base >= 2.0.77"
  ],
  "description": "Automatically builds ghost entities near the player.",
  "thumbnail": "thumbnail.png",
  "package": {
    "git_publish_branch": "main",
    "no_portal_upload": true,
    "no_git_tag": true,
    "scripts": {
      "prepublish": "py -3 publish_mod.py --check",
      "publish": "py -3 publish_mod.py --upload",
      "version": "py -3 publish_mod.py --advance"
    },
    "ignore": [
      "AGENTS.md",
      "mod-list.json",
      "*.py",
      "*.pyc",
      "__pycache__/**",
      "dist/**",
      "docs/**",
      "tests/**"
    ]
  }
}
